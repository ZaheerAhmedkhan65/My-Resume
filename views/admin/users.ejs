<div class="container py-4">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 fw-bold">Manage Users</h1>
      <p class="text-muted">View and manage all registered users.</p>
    </div>
    <a href="/admin/users?role=admin" class="btn btn-outline-primary">Admins</a>
    <a href="/admin/users?role=user" class="btn btn-outline-secondary">Users</a>
    <a href="/admin/users" class="btn btn-outline-dark">All</a>
  </div>

  <!-- Users Table -->
  <div class="card shadow-sm">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Role</th>
              <th>Status</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (users && users.length > 0) { %>
              <% users.forEach(function(u) { %>
                <tr>
                  <td><%= u.id %></td>
                  <td><%= u.name %></td>
                  <td><%= u.email %></td>
                  <td>
                    <span class="badge bg-<%= u.role === 'admin' ? 'danger' : 'primary' %>">
                      <%= u.role %>
                    </span>
                  </td>
                  <td>
                    <span class="badge bg-<%= u.status === 'deleted' ? 'danger' : 'success' %>">
                      <%= u.status || 'active' %>
                    </span>
                  </td>
                  <td class="text-end">
                    <a href="/admin/users/<%= u.id %>" class="btn btn-sm btn-outline-primary">View</a>
                    <% if (String(u.id) !== String(user.id)) { %>
                      <button type="button" class="btn btn-sm btn-outline-warning" onclick="editUser(<%= u.id %>)">Edit</button>
                      <form action="/admin/users/<%= u.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this user?')">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                      </form>
                    <% } else { %>
                      <span class="text-muted small">(you)</span>
                    <% } %>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="6" class="text-center text-muted py-4">No users found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<script>
  function editUser(userId) {
    window.location.href = '/admin/users/' + userId;
  }
</script>