<div class="container py-4">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 fw-bold">User Details</h1>
      <p class="text-muted">Manage user profile and role.</p>
    </div>
    <a href="/admin/users" class="btn btn-outline-primary">
      <i class="bi bi-arrow-left me-2"></i>Back to Users
    </a>
  </div>

  <% if (!profileUser) { %>
    <div class="alert alert-danger">User not found.</div>
  <% } else { %>
    <div class="row g-4">
      <!-- User Profile Card -->
      <div class="col-lg-4">
        <div class="card shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0">Profile</h5>
          </div>
          <div class="card-body text-center">
            <% if (profileUser.profile_photo) { %>
              <img src="<%= profileUser.profile_photo %>" alt="Profile" class="rounded-circle mb-3" width="120" height="120">
            <% } else { %>
              <div class="bg-light rounded-circle d-flex align-items-center justify-content-center mx-auto mb-3" style="width:120px;height:120px;">
                <i class="bi bi-person fs-1 text-muted"></i>
              </div>
            <% } %>
            <h4><%= profileUser.name %></h4>
            <p class="text-muted"><%= profileUser.email %></p>
            <span class="badge bg-<%= profileUser.role === 'admin' ? 'danger' : 'primary' %> p-2">
              <%= profileUser.role %>
            </span>
          </div>
        </div>
      </div>

      <!-- Edit Form -->
      <div class="col-lg-8">
        <div class="card shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0">Edit User</h5>
          </div>
          <div class="card-body">
            <form action="/admin/users/<%= profileUser.id %>" method="POST">
              <input type="hidden" name="_method" value="PUT">
              <div class="row g-3">
                <div class="col-md-6">
                  <label class="form-label">Name</label>
                  <input type="text" name="name" class="form-control" value="<%= profileUser.name %>" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Email</label>
                  <input type="email" name="email" class="form-control" value="<%= profileUser.email %>" required>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Role</label>
                  <select name="role" class="form-select">
                    <option value="user" <%= profileUser.role === 'user' ? 'selected' : '' %>>User</option>
                    <option value="admin" <%= profileUser.role === 'admin' ? 'selected' : '' %>>Admin</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Status</label>
                  <select name="status" class="form-select">
                    <option value="active" <%= (profileUser.status || 'active') === 'active' ? 'selected' : '' %>>Active</option>
                    <option value="deleted" <%= profileUser.status === 'deleted' ? 'selected' : '' %>>Deleted</option>
                  </select>
                </div>
              </div>
              <div class="mt-4">
                <% if (String(profileUser.id) !== String(user.id)) { %>
                  <button type="submit" class="btn btn-primary">Save Changes</button>
                  <a href="/admin/users/<%= profileUser.id %>?_method=DELETE" method="POST" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete this user?')">Delete User</a>
                <% } else { %>
                  <span class="text-muted">You cannot edit your own account from here.</span>
                <% } %>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% } %>

</div>