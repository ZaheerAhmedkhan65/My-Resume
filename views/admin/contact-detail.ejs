<div class="container py-4">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 fw-bold">Contact Details</h1>
      <p class="text-muted">View and update contact submission.</p>
    </div>
    <a href="/admin/contacts" class="btn btn-outline-primary">
      <i class="bi bi-arrow-left me-2"></i>Back to Contacts
    </a>
  </div>

  <% if (!contact) { %>
    <div class="alert alert-danger">Contact not found.</div>
  <% } else { %>
    <div class="row g-4">
      <!-- Contact Info -->
      <div class="col-lg-8">
        <div class="card shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0">Message Details</h5>
          </div>
          <div class="card-body">
            <div class="row mb-3">
              <div class="col-sm-4"><strong>Name:</strong></div>
              <div class="col-sm-8"><%= contact.name %></div>
            </div>
            <div class="row mb-3">
              <div class="col-sm-4"><strong>Email:</strong></div>
              <div class="col-sm-8"><%= contact.email %></div>
            </div>
            <div class="row mb-3">
              <div class="col-sm-4"><strong>Phone:</strong></div>
              <div class="col-sm-8"><%= contact.contact_no || 'Not provided' %></div>
            </div>
            <div class="row mb-3">
              <div class="col-sm-4"><strong>Status:</strong></div>
              <div class="col-sm-8">
                <span class="badge bg-<%= contact.status === 'new' ? 'warning' : contact.status === 'read' ? 'info' : 'success' %>">
                  <%= contact.status %>
                </span>
              </div>
            </div>
            <div class="row mb-3">
              <div class="col-sm-4"><strong>Date:</strong></div>
              <div class="col-sm-8"><%= new Date(contact.created_at).toLocaleString() %></div>
            </div>
            <div class="row mb-3">
              <div class="col-sm-4"><strong>Message:</strong></div>
              <div class="col-sm-8">
                <div class="bg-light p-3 rounded border"><%= contact.message %></div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Update Status Form -->
      <div class="col-lg-4">
        <div class="card shadow-sm">
          <div class="card-header bg-white">
            <h5 class="mb-0">Update Status</h5>
          </div>
          <div class="card-body">
            <form action="/admin/contacts/<%= contact.id %>" method="POST">
              <input type="hidden" name="_method" value="PUT">
              <div class="mb-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                  <option value="new" <%= contact.status === 'new' ? 'selected' : '' %>>New</option>
                  <option value="read" <%= contact.status === 'read' ? 'selected' : '' %>>Read</option>
                  <option value="replied" <%= contact.status === 'replied' ? 'selected' : '' %>>Replied</option>
                </select>
              </div>
              <button type="submit" class="btn btn-primary w-100">Update Status</button>
            </form>
            <hr>
            <form action="/admin/contacts/<%= contact.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this contact?')">
              <button type="submit" class="btn btn-outline-danger w-100">Delete Contact</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  <% } %>

</div>