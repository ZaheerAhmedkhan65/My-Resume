<div class="container py-4">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 fw-bold">Manage Contacts</h1>
      <p class="text-muted">View and manage contact form submissions.</p>
    </div>
    <a href="/admin/contacts?status=new" class="btn btn-outline-warning">New</a>
    <a href="/admin/contacts?status=read" class="btn btn-outline-info">Read</a>
    <a href="/admin/contacts?status=replied" class="btn btn-outline-success">Replied</a>
    <a href="/admin/contacts" class="btn btn-outline-dark">All</a>
  </div>

  <!-- Stats Summary -->
  <div class="row g-3 mb-4">
    <div class="col-md-3">
      <div class="card bg-light text-dark shadow-sm">
        <div class="card-body text-center">
          <h6 class="text-muted">Total</h6>
          <h3 class="mb-0"><%= total || 0 %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-warning text-white shadow-sm">
        <div class="card-body text-center">
          <h6 class="text-white-50">New</h6>
          <h3 class="mb-0"><%= newCount || 0 %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-info text-white shadow-sm">
        <div class="card-body text-center">
          <h6 class="text-white-50">Read</h6>
          <h3 class="mb-0"><%= readCount || 0 %></h3>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card bg-success text-white shadow-sm">
        <div class="card-body text-center">
          <h6 class="text-white-50">Replied</h6>
          <h3 class="mb-0"><%= repliedCount || 0 %></h3>
        </div>
      </div>
    </div>
  </div>

  <!-- Contacts Table -->
  <div class="card shadow-sm">
    <div class="card-body">
      <div class="table-responsive">
        <table class="table table-hover align-middle">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Name</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Status</th>
              <th>Date</th>
              <th class="text-end">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (contacts && contacts.length > 0) { %>
              <% contacts.forEach(function(c) { %>
                <tr>
                  <td><%= c.id %></td>
                  <td><%= c.name %></td>
                  <td><%= c.email %></td>
                  <td><%= c.contact_no || '-' %></td>
                  <td>
                    <span class="badge bg-<%= c.status === 'new' ? 'warning' : c.status === 'read' ? 'info' : 'success' %>">
                      <%= c.status %>
                    </span>
                  </td>
                  <td><%= new Date(c.created_at).toLocaleDateString() %></td>
                  <td class="text-end">
                    <a href="/admin/contacts/<%= c.id %>" class="btn btn-sm btn-outline-primary">View</a>
                    <form action="/admin/contacts/<%= c.id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this contact?')">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center text-muted py-4">No contacts found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>