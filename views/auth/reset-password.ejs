<%- include('_nav') %>
<div class="container my-5">

  <div class="row justify-content-center">
    <div class="col-lg-6 col-md-9 col-12">
      <div class="card border-0">
        <div class="card-body">
          <div class="card-title text-center">
            <h2>Reset Password</h2>
            <p class="text-muted">
              Your new password must match the confirmation password. Please choose a strong password
              that you haven't used before.
            </p>
          </div>
          <div class="row justify-content-center mt-4">
            <div class="col-lg-4 col-md-8 col-12">
              <form action="/auth/reset-password" method="POST">
                <input type="hidden" name="token" value="<%= token %>">

                <div class="form-group mb-3">
                  <label for="newPassword" class="form-label mb-1">New Password</label>
                  <div class="position-relative d-flex align-items-center">
                    <input type="password" class="form-control p-3" id="newPassword" name="newPassword" placeholder="Enter new password" autocomplete="off" required>
                    <button type="button" class="btn border-0 outline-0 position-absolute end-0 fs-4">
                      <i class="bi bi-eye"></i>
                    </button>
                  </div>
                </div>

                <div class="form-group mb-3">
                  <label for="confirmPassword" class="form-label mb-1">Confirm Password</label>
                  <div class="position-relative d-flex align-items-center">
                    <input type="password" class="form-control p-3" id="confirmPassword" name="confirmPassword" placeholder="Enter confirm password" autocomplete="off" required>
                    <button type="button" class="btn border-0 outline-0 position-absolute end-0 fs-4">
                      <i class="bi bi-eye"></i>
                    </button>
                  </div>
                </div>

                <div class="text-center mt-4">
                  <button type="submit" class="btn btn-lg btn-primary rounded-pill">Reset password</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>