{
  "name": "my-resume",
  "version": "1.0.0",
  "description": "Visit My Portfolio: https://muhammadabdullaah.github.io/My-Resume/",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "dev": "npx nodemon server.js",
    "db:create": "dotenv -e .env -- sh -c 'mysql -u $DB_USER -p$DB_PASS < database_schema/schema.sql'",
    "db:seed": "dotenv -e .env -- sh -c 'mysql -u $DB_USER -p$DB_PASS < database_schema/seed.sql'",
    "db:drop": "dotenv -e .env -- sh -c 'mysql -u $DB_USER -p$DB_PASS < database_schema/drop.sql'",
    "db:rest": "npm run db:drop && npm run db:create && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.3.1",
    "ejs": "^5.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-mysql-session": "^3.0.3",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "method-override": "^3.0.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "path": "^0.12.7"
  }
}